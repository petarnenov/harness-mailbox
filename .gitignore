# Local workflow logs, screenshots, credentials and tooling
.claude/
.codex/
.playwright-mcp/
.env
.env.*
!.env.example
.tools/
.venv/
node_modules/
__pycache__/
*.py[cod]
.coverage
.coverage.*
coverage.json
htmlcov/
.pytest_cache/
.DS_Store

# Mailbox data belongs outside Git; a standalone checkout keeps it in the ignored mailbox-data/
/mailbox-data/
/data/
/projects.json
/projects/
/epics/
/tasks/
/sessions/
/inbox/
/outbox/
/archive/
/.copilot-mailbox-tmux-socket
/.copilot-mailbox-team.lock
/.copilot-mailbox-orchestrator.lock
/.team-registry.lock
/.team-registry-*
/.team-socket-*
/discovery/
/dispatch-gates/
/decisions/
/deliveries/
/jira-sync/
/reports/
/status-rounds/
/.status-round-runner.lock

# The workspace template holds no gate records
/workspace/dispatch-gates/

# Make workflow coverage artifacts
.coverage-output/

# Workspace instructions and skills are tracked under workspace/
!/workspace/.claude/

# Delivery package (da.*): canonical skills, agents and hooks are tracked; run history stays local
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/agents/
!/.claude/hooks/
/.claude/agents/*
!/.claude/agents/da-*.md
/.claude/hooks/*
!/.claude/hooks/path-guard.py
/.claude/skills/*
!/.claude/skills/da.*/
!/.claude/skills/da-*/
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/config.toml
!/.codex/agents/

# Local provenance and source archives
/.claude/skills/*/references/*-origin/
/.claude/skills/*/references/upstream.json
